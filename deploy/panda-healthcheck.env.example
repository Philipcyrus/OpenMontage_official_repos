# Daily Panda health check: private settings for THIS box.
# deploy/install_healthcheck.sh copies this file to ~/.config/panda-healthcheck.env (mode 600).
# Never commit the real file: webhook URLs are credentials.
# Every setting has a working default. Normally you only set the alert destination,
# PANDA_HEALTH_PUBLIC_URL and PANDA_HEALTH_BOX_NAME.

# --- Where alerts go (one or both) ----------------------------------------------------------
# Incoming webhook. kind: slack | discord | generic. generic posts {"text": "..."}, which
# Google Chat accepts.
PANDA_HEALTH_WEBHOOK_URL=
PANDA_HEALTH_WEBHOOK_KIND=slack
# AWS SNS (email or SMS subscribers). Needs boto3 and sns:Publish on the instance role.
PANDA_HEALTH_SNS_TOPIC_ARN=
AWS_REGION=
# true = also send a short "all OK" message every day, so silence means the check itself
# stopped running. false = alert only on failure, change, reminder and recovery.
PANDA_HEALTH_NOTIFY_SUCCESS=true
PANDA_HEALTH_REMINDER_HOURS=24

# --- This box -----------------------------------------------------------------------------
# A label for alerts (default: the hostname), e.g. box1-prod.
PANDA_HEALTH_BOX_NAME=
# Dify's BASE_URL for this box, e.g. https://dev.om.mvnoc.ai. Tests DNS, TLS, the reverse
# proxy, and that the URL reaches THIS launcher. Empty = that layer is not tested.
PANDA_HEALTH_PUBLIC_URL=
# The runner production must use. "off" disables the check (e.g. a deliberate mock box).
PANDA_HEALTH_EXPECT_RUNNER=claude

# --- Thresholds ("off" disables a threshold) ------------------------------------------------
PANDA_HEALTH_LOW_CREDITS=500               # Higgsfield credits
PANDA_HEALTH_ELEVENLABS_LOW_CHARS=10000    # ElevenLabs characters left this period
PANDA_HEALTH_DISK_MIN_FREE_GB=5
PANDA_HEALTH_DISK_MIN_FREE_PCT=10
PANDA_HEALTH_TLS_WARN_DAYS=14

# --- Optional (defaults shown) --------------------------------------------------------------
# PANDA_HEALTH_LAUNCHER_URL=http://127.0.0.1:8501/health
# PANDA_HEALTH_LAUNCHER_ENV_FILE=          # default: <repo>/.env, the file the launcher loads
# PANDA_HEALTH_CLAUDE_BIN=                 # default: the claude the running launcher resolves
# PANDA_HEALTH_REQUIRE_REMOTION=auto       # auto = only when screenshot jobs are on (DIFY_FILES_HOSTS)
# PANDA_HEALTH_ELEVENLABS=on
# PANDA_HEALTH_EXTRA_URLS=                 # e.g. dify=https://dify.example.com (any HTTP answer below 500 passes)
# PANDA_HEALTH_CLAUDE_MODEL=haiku
# PANDA_HEALTH_CLAUDE_TIMEOUT_S=90
# PANDA_HEALTH_MAX_BUDGET_USD=0.10
# PANDA_HEALTH_RETRY_COUNT=1
# PANDA_HEALTH_RETRY_DELAY_S=60
# PANDA_HEALTH_STATE_FILE=~/.local/state/panda-healthcheck/status.json
