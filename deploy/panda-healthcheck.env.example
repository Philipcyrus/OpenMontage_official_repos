# Copy to ~/.config/panda-healthcheck.env and chmod 600.
# Never commit the real file: webhook URLs are credentials.

PANDA_HEALTH_REPO=/home/ec2-user/OpenMontage-Repos/OpenMontage_official_repos
PANDA_HEALTH_CLAUDE_BIN=/home/ec2-user/.nvm/versions/node/v22.23.2/bin/claude
PANDA_HEALTH_LAUNCHER_URL=http://127.0.0.1:8501/health

# The verified canary uses Claude Haiku, no session persistence, no auto-memory,
# max 4 turns, and only ToolSearch + Higgsfield balance. It generates no media.
PANDA_HEALTH_CLAUDE_MODEL=haiku
PANDA_HEALTH_CLAUDE_TIMEOUT_S=90
PANDA_HEALTH_MAX_BUDGET_USD=0.10
PANDA_HEALTH_RETRY_COUNT=1
PANDA_HEALTH_RETRY_DELAY_S=60

# Set to off to disable the balance warning.
PANDA_HEALTH_LOW_CREDITS=500
PANDA_HEALTH_REMINDER_HOURS=24
PANDA_HEALTH_NOTIFY_SUCCESS=false
PANDA_HEALTH_STATE_FILE=/home/ec2-user/.local/state/panda-healthcheck/status.json

# Choose AWS SNS, a webhook, or both. Leave unused values empty.
# SNS is recommended on EC2: grant the instance role sns:Publish on this topic.
PANDA_HEALTH_SNS_TOPIC_ARN=
AWS_REGION=

# Slack: kind=slack. Discord: kind=discord. "generic" sends {"text":"..."}.
PANDA_HEALTH_WEBHOOK_URL=
PANDA_HEALTH_WEBHOOK_KIND=slack
