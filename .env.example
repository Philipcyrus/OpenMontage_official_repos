# =============================================================================
# Panda AI Video System — environment template
# Copy to `.env` and fill in real values ON THE EC2 BOX. Never commit `.env`.
# `.env` is gitignored; keep every secret here, never in code or the repo.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) LLM — the agent's brain (Claude Code / Claude Agent SDK)
#    We use OpenRouter (no direct Anthropic key). OpenRouter exposes a native
#    Anthropic Messages API, so no proxy is needed.
#    Use OpenRouter's CLAUDE models (Sonnet/Opus) — the pipeline is tool-heavy.
# -----------------------------------------------------------------------------
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=
# Optional: pin the model the SDK/CLI requests (OpenRouter model id).
# ANTHROPIC_MODEL=anthropic/claude-opus-4.1

# -----------------------------------------------------------------------------
# 1b) Dify launcher + runner
#    DIFY_RUNNER=mock  → fakes script/gen (Dify handshake works, no real AI video)
#    DIFY_RUNNER=claude→ drives the REAL agent (Claude Code headless) — needs the LLM env
#                        above + the Higgsfield MCP below.
# -----------------------------------------------------------------------------
DIFY_RUNNER=mock
DIFY_TOKEN=
DIFY_DATA_DIR=/opt/panda/data
# claude runner only:
CLAUDE_BIN=claude
# headless can't answer permission prompts. NOTE: no inline comment on the next line —
# systemd EnvironmentFile does NOT strip trailing "# ..." and it would leak into claude's argv.
CLAUDE_EXTRA_ARGS=--dangerously-skip-permissions
CLAUDE_TIMEOUT_S=3600
PANDA_PIPELINE_TYPE=panda-video
# OPENMONTAGE_PROJECTS_DIR=/opt/panda/projects      # where checkpoints/artifacts live

# -----------------------------------------------------------------------------
# 1c) User screenshots (POST /jobs options.media; panda-video, panda-carousel, panda-image)
#    — OFF until DIFY_FILES_HOSTS is set.
#    The launcher downloads Dify file links ONLY from these hosts (comma-separated), never
#    follows redirects, and needs Node 22 + remotion-composer (see deploy/README.md).
#    DIFY_FILES_BASE prefixes relative "/files/..." links when Dify's FILES_URL is unset.
# -----------------------------------------------------------------------------
DIFY_FILES_HOSTS=
DIFY_FILES_BASE=
# SCREENSHOT_MAX_FILES=20
# SCREENSHOT_MAX_MB=10
# SCREENSHOT_TOTAL_MB=150
# SCREENSHOT_STILLS_BUDGET_S=300   # carousel / image: seconds a placement pass may START renders in
# SCREENSHOT_TIMELINE_TOLERANCE_S=0.75  # video: how far the final may run from the timeline
#                                       # compose recorded before the final check reports
#                                       # itself as unavailable instead of guessing
#                                  # (the render under way still finishes; the pre-brand pass is unbounded)

# -----------------------------------------------------------------------------
# 2) Higgsfield — video/image generation via MCP (NOT the Cloud REST API)
#    HIGGSFIELD_MCP_BRIDGE=1 tells the bridge tool "this agent has a working
#    Higgsfield MCP connection". On a HEADLESS box you must connect a
#    server-friendly MCP (self-hosted key+secret or CLI) — the claude.ai
#    browser connector does NOT work headless. See setup guide §5.3 / §8.
# -----------------------------------------------------------------------------
HIGGSFIELD_MCP_BRIDGE=1
# Only needed for the self-hosted MCP server option (headless):
HIGGSFIELD_API_KEY=
HIGGSFIELD_SECRET=
# NOTE: do NOT set these to use the rejected Cloud REST tool (higgsfield_video.py).
# They exist solely to authenticate a self-hosted Higgsfield MCP server.

# -----------------------------------------------------------------------------
# 3) ElevenLabs — voiceover (the PRODUCTION brand voice)
#    REQUIRED for the on-brand panda/customer voices (ids in config/panda-elements.json).
#    Without this the agent falls back to Higgsfield seed_audio (a generic preset, NOT the
#    brand voice) — that's what happened on the first real run. Set the key (or connect an
#    ElevenLabs MCP) so narration uses the real ElevenLabs voice_ids.
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# -----------------------------------------------------------------------------
# 4) fal.ai — Seedance video (character-consistent generation), if used
# -----------------------------------------------------------------------------
FAL_KEY=

# -----------------------------------------------------------------------------
# 4b) Kling (official API). The Panda pipeline still generates every clip via the
#    Higgsfield MCP. Kling is used only by jobs that send
#    options.customer_lipsync_provider="kling": it re-drives the CUSTOMER's mouth in
#    customer-only speaking scenes (never the panda). Empty key = nothing is sent to
#    Kling and those jobs keep their Seedance lip-sync. Restart the launcher after
#    setting it.
# -----------------------------------------------------------------------------
KLING_API_KEY=
KLING_API_BASE_URL=
# KLING_LIPSYNC_CONCURRENCY=2     # clips in flight at once (1-4)
# KLING_LIPSYNC_TIMEOUT_S=360     # how long one pass waits for Kling (keep it under the agent's
#                                 # 10-minute command limit); what is still processing is
#                                 # collected by the next run, never resent
# KLING_LIPSYNC_POLL_S=5

# -----------------------------------------------------------------------------
# 5) Render — FOLDED IN, no separate service.
#    montage-svc's render code is vendored at vendor/montage_svc and called
#    in-process by the panda_render / panda_brand tools. No MONTAGE_SVC_URL.
#    Optional overrides (defaults are vendor/brand and vendor/data):
#      MONTAGE_BRAND_DIR  — brand assets (logo, profiles, fonts)
#      MONTAGE_DATA_DIR   — render scratch (gitignored)
#    A CJK font (msyhbd.ttc) must resolve for Chinese captions (see setup guide).
# -----------------------------------------------------------------------------
# MONTAGE_BRAND_DIR=
# MONTAGE_DATA_DIR=
#    ffmpeg/ffprobe: the render calls them by name via PATH. If the service runs under a
#    PATH that resolves ffmpeg but not ffprobe (e.g. a static build in /usr/local/bin that
#    the systemd/nohup process can't see), probing fails mid-compose. Pin absolute paths to
#    remove all ambiguity (recommended on servers):
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# FFPROBE_BIN=/usr/local/bin/ffprobe

# -----------------------------------------------------------------------------
# 6) AWS S3 — artifact storage (final videos, stills, reports)
#    Prefer an EC2 instance role over static keys where possible.
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
S3_BUCKET=pm-ai-artifacts-prod
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# 7) Postgres — the artifact map + review state (job_artifacts, review status)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@host:5432/panda_ai

# -----------------------------------------------------------------------------
# 8) WeCom (optional) — WeChat Work delivery (existing Mochi bridge)
#    SECURITY: rotate the APP_SECRET that was shared in plaintext earlier.
# -----------------------------------------------------------------------------
# WECOM_CORP_ID=
# WECOM_APP_SECRET=
